# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
# Резервные копии сборки (напр. .next.bak-20261002-064140). Правило `/.next/`
# со слэшем покрывает ТОЛЬКО сам каталог .next, поэтому бак-каталоги
# просачивались в репозиторий. Закрываем явно.
.next.bak-*/
*.bak-*/
# Мусор от iCloud/Finder: «package 3.json», «build-manifest 3.json» и т.п.
* 3.json

# audit/qa — рабочие артефакты исследований (скриншоты конкурентов, html-дампы
# поиска, сохранённые страницы QA). НЕ документация продукта: 111 файлов и
# 8.8 МБ, из-за чего ИИ-агенты и новые разработчики читали шум вместо кода.
# Файлы остаются на диске (git rm --cached), история сохраняется.
.audit/
work/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# Ключ Polza для скилла ai-product-feedback (опрос ИИ-моделей о продукте)
.env.ai-feedback

# wrangler state
.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Симлинки на node_modules (воркtree) не должны попадать в коммит.
# Слэш в **/node_modules/ ловит только каталоги, симлинк-файл проходит мимо.
**/node_modules

# playwright: артефакты прогонов и скриншоты падающих тестов.
# Без этих правил `test-results/` и `tests/screenshots/` попадали в
# `git add -A` после каждого e2e-прогона.
test-results/
playwright-report/
tests/screenshots/

# Секретные ключи почты (никогда не коммитить)
backend/.resend.key

# Служебное от unlazy: локальные гейты и журналы прогонов. Машина-зависимое,
# в репозитории не хранится (см. SKILL.md скилла unlazy).
.unlazy/
GATES.md

# Ответы ИИ-моделей о продукте (скилл ai-product-feedback)
ai-feedback/

# Сборка Next внутри nameone/ — правило `/out/` покрывает только корень
# репозитория, а билд лежит на уровень глубже и раньше попадал в коммиты
# (8140 файлов за одну сборку).
/nameone/out/
/nameone/.next/

# Промежуточные файлы выгрузки тем ФГОС: .tmp и .correct.txt — черновики,
# в репозитории им не место.
*.tmp
*.correct.txt

# «cloudflare-test-env.d 2.ts» и подобные — копии Finder/iCloud с суффиксом
# « N». Блокируются по маске, потому что появляются снова при каждом
# столкновении с облачным диском.
backend/tests/cloudflare-test-env.d 2.ts

# Пробники, которыми проверяли запись и права на D1/локальной базе.
.probe*
.wtest
_probe*
