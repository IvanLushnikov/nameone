# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/
# Резервные копии сборки (напр. .next.bak-20261002-064140). Правило `/.next/`
# со слэшем покрывает ТОЛЬКО сам каталог .next, поэтому бак-каталоги
# просачивались в репозиторий. Закрываем явно.
.next.bak-*/
*.bak-*/
# Мусор от iCloud/Finder: «package 3.json», «build-manifest 3.json» и т.п.
* 3.json

# audit/qa — рабочие артефакты исследований (скриншоты конкурентов, html-дампы
# поиска, сохранённые страницы QA). НЕ документация продукта: 111 файлов и
# 8.8 МБ, из-за чего ИИ-агенты и новые разработчики читали шум вместо кода.
# Файлы остаются на диске (git rm --cached), история сохраняется.
.audit/
work/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# wrangler state
.wrangler/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Симлинки на node_modules (воркtree) не должны попадать в коммит.
# Слэш в **/node_modules/ ловит только каталоги, симлинк-файл проходит мимо.
**/node_modules

# playwright: артефакты прогонов и скриншоты падающих тестов.
# Без этих правил `test-results/` и `tests/screenshots/` попадали в
# `git add -A` после каждого e2e-прогона.
test-results/
playwright-report/
tests/screenshots/
