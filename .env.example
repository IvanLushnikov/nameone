# Cloudflare Pages deploy — заполни .env (НЕ коммитится, см. .gitignore)
# Account ID — общий для всех деплоев аккаунта, можно коммитить публично
CLOUDFLARE_ACCOUNT_ID=9fe2955fcf08aecf91754823a7aae0aa

# API Token — Edit Pages permission. НЕ КОММИТЬ. Положи в .env рядом с этим файлом.
# Создать: https://dash.cloudflare.com/profile/api-tokens → Create Token → Edit Pages
CLOUDFLARE_API_TOKEN=your_token_here

# Опционально: имя проекта (по умолчанию listai-prototype)
CF_PAGES_PROJECT=listai-prototype

# F-05-B: URL Cloudflare Worker-а для self-verification задач.
# dev:  http://localhost:8787 (по умолчанию в коде, запускается через `wrangler dev`)
# prod: https://listai-self-verify.<account>.workers.dev (см. docs/07-tasks-f05.md Subtask #3)
# NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# LLM-провайдеры для фронта — НЕ СЕКРЕТЫ, только маркеры "провайдер включён".
# Реальные ключи хранятся на бэке через `wrangler secret put`.
# Polza — primary для РФ (юрлица, ФЗ-152, ₽). Ключ в личном кабинете polza.ai.
# Любой непустой маркер = бэк использует этого провайдера (см. router.ts).
NEXT_PUBLIC_POLZA_PROVIDER=1

# Базовый URL сайта — попадает в sitemap.xml, robots.txt, canonical и og:image.
# Это единственное место, где задаётся канонический домен (то же значение дублируется
# в .github/workflows/deploy.yml — переменные читаются на этапе сборки, не в рантайме).
#
# ТЗ-21 п.1: дефолтом здесь и в src/lib/site.ts стоял временный listai-prototype.pages.dev,
# из-за чего весь SEO-вес копился на адресе, который после переезда выключается.
# Продовый домен выбран владельцем 2026-10-03, но ЕЩЁ НЕ куплен и не резолвится.
#
# ✅ 2026-10-07: uchlist.ru куплен и делегирован на Cloudflare, домен привязан
# к Pages-проекту. Значение обязано совпадать с deploy.yml и дефолтом в
# src/lib/site.ts. Раньше здесь стоял pages.dev — он больше не используется.
NEXT_PUBLIC_SITE_URL=https://uchlist.ru

# Почта поддержки: показывается в футере, в JSON-LD главной и в оферте.
# На неделегированный домен письма не доходят — учитель пишет «в поддержку», ответа нет.
NEXT_PUBLIC_SUPPORT_EMAIL=hello@uchlist.ru

# Реквизиты оператора персональных данных — попадают в публичную оферту и в
# согласие на обработку ПДн (src/lib/site.ts → src/app/legal/[slug]/page.tsx).
#
# ⚠️ ОБЯЗАТЕЛЬНО ЗАПОЛНИ ПЕРЕД ПРОДОМ. Ч. 4 ст. 9 152-ФЗ требует в согласии
# ФИО и адрес оператора. Без них согласие недействительно, а форма его сбора —
# нарушение: штраф по ч. 2 ст. 13.11 КоАП, 300–700 тыс. ₽. Сейчас на живом
# сайте /legal/consent адрес не выводится.
#
# Оператор — самозанятый (НПД, гл. 23 НК РФ), не ИП: наименования и ОГРНИП
# у этого режима нет, плательщик идентифицируется ИНН из «Мой налог».
# ИНН обязателен ещё и для приёма оплаты от юрлиц — без чека они не смогут
# оплатить, так как не смогут принять расход в учёт.
NEXT_PUBLIC_OPERATOR_NAME=Лушников Иван
NEXT_PUBLIC_OPERATOR_INN=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_API_URL=http://localhost:8787
# TZ-10 §8.1 / §9.1: Яндекс.Метрика.
# Создать счётчик: https://metrika.yandex.ru → Добавить счётчик → получить 8-значный ID.
# Положить в .env (НЕ .env.example), затем редеплоить. Пустая строка = Метрика отключена.
NEXT_PUBLIC_YM_ID=
