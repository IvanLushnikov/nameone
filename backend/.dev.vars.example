# Скопируй этот файл в `.dev.vars` и заполни реальными ключами для `wrangler dev --local`.
# В проде эти же переменные задаются через `wrangler secret put <KEY>`.
# .dev.vars — в .gitignore, никогда не коммить.

# LLM — единственный провайдер для РабочиеЛисты AI.
# Polza.ai — российский агрегатор, один ключ покрывает все модели
# (openai/gpt-6-luna, anthropic/claude-opus-5.5, deepseek/deepseek-v4-flash,
#  qwen/qwen3-embedding-8b, openai/text-embedding-3-large).
# Юрлицам РФ: оплата ₽/безнал/счёт, ФЗ-152 на части провайдеров.
# Ключ берётся в личном кабинете polza.ai → API.
POLZA_API_KEY=

# Email (magic-link)
RESEND_API_KEY=

# Платежи (ЮKassa)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Сессии — замени на 32-байтную hex-строку перед прод-деплоем
JWT_SECRET=dev-only-replace-in-prod-with-32-byte-hex

# Опционально: кто считается админом (для /api/admin/*)
ADMIN_EMAIL=
