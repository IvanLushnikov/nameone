# Скопируй этот файл в `.dev.vars` и заполни реальными ключами для `wrangler dev --local`.
# В проде эти же переменные задаются через `wrangler secret put <KEY>`.
# .dev.vars — в .gitignore, никогда не коммить.

# LLM — единственный провайдер для РабочиеЛисты AI.
# Polza.ai — российский агрегатор, один ключ покрывает все модели
# (openai/gpt-6-luna, anthropic/claude-opus-5.5, deepseek/deepseek-v4-flash,
#  qwen/qwen3-embedding-8b, openai/text-embedding-3-large).
# Юрлицам РФ: оплата ₽/безнал/счёт, ФЗ-152 на части провайдеров.
# Ключ берётся в личном кабинете polza.ai → API.
POLZA_API_KEY=

# Email (magic-link)
#
# ОБЯЗАТЕЛЕН. Пока переменная не задана, письмо не отправляется, а ссылка для
# входа НЕ возвращается в ответе — вход закрывается с ошибкой и записью в лог.
# Раньше ссылка возвращалась, если не задан APP_ENV=production; 2 октября 2026
# выяснилось, что боевой воркер задеплоен именно с APP_ENV=development, и
# защита выключалась молча. Теперь решение принимает отдельный флаг.
#
# ВАЖНО: ALLOW_DEV_MAGIC_URL разрешает отдачу ссылки входа в ответе. Это удобно
# для локальной разработки и опасно на публичном сервере: тот, кто знает чужой
# email, войдёт в чужой аккаунт. Ставьте "true" ТОЛЬКО в .dev.vars, никогда
# в [env.production.vars].
# На проде задать: npx wrangler secret put RESEND_API_KEY --name rabochielisty-api
ALLOW_DEV_MAGIC_URL=true
RESEND_API_KEY=

# Платежи (ЮKassa)
# Аналогично: без ключей оплата не работает и НЕ подменяется симуляцией.
# ALLOW_DEMO_PAYMENTS разрешает фиктивные платежи — только для локальной машины.
ALLOW_DEMO_PAYMENTS=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Сессии — замени на 32-байтную hex-строку перед прод-деплоем
JWT_SECRET=dev-only-replace-in-prod-with-32-byte-hex

# Опционально: кто считается админом (для /api/admin/*)
ADMIN_EMAIL=
