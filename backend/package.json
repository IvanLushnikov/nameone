{
  "name": "@uchlist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend для УчЛист: Hono + D1 + R2 на Cloudflare Workers.",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy --env production",
    "deploy:staging": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute rabochielisty --local --file=src/db/schema.sql",
    "db:migrate:prod": "wrangler d1 execute rabochielisty --remote --file=src/db/schema.sql",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "tsx tests/smoke.ts",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "hono": "^4.13.13",
    "nanoid": "^6.0.2",
    "openai": "^4.104.0",
    "resend": "^4.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261004.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261012.1": true
  }
}
