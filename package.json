{
  "name": "nameone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:clean && tsc --noEmit && next build --no-lint && npm run build:prune",
    "build:clean": "node scripts/clean-export.mjs",
    "build:prune": "node scripts/prune-export.mjs",
    "build:full": "next build",
    "start": "next start",
    "lint": "next lint",
    "smoke": "tsx scripts/smoke-llm.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:tz26": "npm run lint && echo TZ26-LINT-OK",
    "test:tz26": "npm test && npm test --prefix backend && echo TZ26-TESTS-OK"
  },
  "dependencies": {
    "@types/qrcode.react": "^1.0.5",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "docx": "^9.8.1",
    "file-saver": "^2.0.5",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.18.10",
    "lucide-react": "^1.48.0",
    "next": "14.2.35",
    "qrcode.react": "^4.2.0",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/ui": "^4.1.11",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "hono": "^4.13.13",
    "jsdom": "^27.0.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.140.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260923.1": true,
    "esbuild@0.28.1": true
  }
}
